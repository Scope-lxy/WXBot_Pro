# Git backup rules for local development on Windows

# Virtual environments
.venv/
venv/
venv2/

# Python cache
__pycache__/
*.py[cod]
.pycache_verify/

# Build and release artifacts
build/
dist/
releases/
*.spec
*.zip
*.whl

# Bundled runtime and local tools cache
runtime/

# Logs and historical backups
panel_logs/
wxbot_logs/
wxauto_logs/
wxbot_save/
logs/
backups/
backup/

# Private runtime data
data/accounts/
data/cache/
data/config/

# Prompt/persona data is local-private; keep only the two reusable templates
data/prompt/*
!data/prompt/模板.md
!data/prompt/模板-人设近况.md

# Keep software-owned prompt assets, but skip generated prompt backups
data/system_prompts/prompt_backup/

# Local test assets
tools/ui_conflict_test_config.json

# Local agent instructions; keep them out of repository backups and pushes
/AGENTS.md
/CLAUDE.md
